generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Presave {
  id              String   @id @default(cuid())
  songTitle       String
  artistName      String
  releaseDate     String
  userId          String
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  streamingService String
  quizResult      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userTokens      UserStreamingTokens? @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model UserStreamingTokens {
  id             String   @id @default(cuid())
  userId         String   @unique
  spotifyToken   String?
  appleMusicToken String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  presaves       Presave[]

  @@index([userId])
} 